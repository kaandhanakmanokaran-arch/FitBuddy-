# FitBuddy configuration
APP_NAME=FitBuddy
DEBUG=true
DATABASE_URL=sqlite:///./fitbuddy.db

# Get a Gemini API key from Google AI Studio.
# Leave blank to run the app in local DEMO mode.
GEMINI_API_KEY=

# Current stable model defaults. They can be changed without editing Python.
GEMINI_WORKOUT_MODEL=gemini-3.8-flash
GEMINI_TIP_MODEL=gemini-3.8-flash

# Optional simple local admin token. Leave blank to disable token checking.
# If set, open /view-all-users?admin_token=YOUR_TOKEN
ADMIN_TOKEN=

# Comma-separated CORS origins if the frontend is hosted separately.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
